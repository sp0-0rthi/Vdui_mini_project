table Predictions
	lineageTag: a077fae1-3c45-4c91-8b4e-e7c2ee025641

	measure 'Selected score' = SELECTEDVALUE(Predictions[model_score])
		formatString: 0.000
		lineageTag: cbd008b7-2802-4f44-94cf-c0a589e20163

	measure 'Mean model score' = AVERAGE(Predictions[model_score])
		formatString: 0.000
		lineageTag: d3b1b62b-8ae9-4ea7-9d51-7f037a71df0b

	measure 'Threshold scatter score' = IF(MAX(Predictions[oof_p_decline]) >= SELECTEDVALUE(AuditThreshold[Value], 0.7), MAX(Predictions[model_score]))
		formatString: 0.000
		lineageTag: eaffceef-592e-4428-8aa9-39ce0dc9aa0c

	measure 'Case year' = MAX(Predictions[time_t])
		formatString: 0
		lineageTag: 1b7caf2d-a4af-4bee-ae63-30d7b3dd5c9f

	measure 'Audit case match' = IF(MAX(Predictions[oof_p_decline]) >= SELECTEDVALUE(AuditThreshold[Value], 0.7), 1, 0)
		formatString: 0
		lineageTag: 8ae01f58-8505-4c7e-888e-7d72182319f9

	measure 'Audit summary' = (CALCULATE(COUNTROWS(Predictions), Predictions[oof_p_decline] >= SELECTEDVALUE(AuditThreshold[Value], 0.7)) + 0) & " cases at threshold " & FORMAT(SELECTEDVALUE(AuditThreshold[Value], 0.7), "0.00")
		lineageTag: 8b851c0e-dcd1-43a7-aecc-da22821c9d8b

	measure 'Flagged cases' = CALCULATE(COUNTROWS(Predictions), Predictions[oof_p_decline] >= SELECTEDVALUE(AuditThreshold[Value], 0.7))
		formatString: 0
		lineageTag: 11b8baf3-4b1c-4b84-8407-a3470746b3ab

